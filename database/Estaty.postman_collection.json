  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Auto-fetch authentication token for Estaty API",
          "// This script runs before every request in the collection",
          "",
          "// List of endpoints that don't require authentication",
          "const publicEndpoints = [",
          "    '/home',",
          "    '/properties',",
          "    '/get-lang',",
          "    '/user/login',",
          "    '/user/signup',",
          "    '/user/login/submit',",
          "    '/user/signup/submit'",
          "];",
          "",
          "// Get the current request URL",
          "const currentUrl = pm.request.url.toString();",
          "",
          "// Check if current request is a public endpoint (no auth needed)",
          "const isPublicEndpoint = publicEndpoints.some(endpoint => currentUrl.includes(endpoint));",
          "",
          "if (!isPublicEndpoint) {",
          "    // Check if we have a valid token",
          "    const token = pm.environment.get('token');",
          "    ",
          "    if (!token) {",
          "        console.log('No token found. Fetching new token...');",
          "        ",
          "        // Get the base URL from environment",
          "        const baseUrl = pm.environment.get('baseUrl') || pm.environment.get('baseURL');",
          "        ",
          "        if (!baseUrl) {",
          "            console.error('baseUrl/baseURL environment variable is not set. Cannot fetch token.');",
          "        } else {",
          "            // Make login request to get token",
          "            const loginRequest = {",
          "                url: `${baseUrl}/user/login/submit`,",
          "                method: 'POST',",
          "                header: {",
          "                    'Content-Type': 'multipart/form-data'",
          "                },",
          "                body: {",
          "                    mode: 'formdata',",
          "                    formdata: [",
          "                        { key: 'username', value: 'test' },",
          "                        { key: 'password', value: '000000' }",
          "                    ]",
          "                }",
          "            };",
          "            ",
          "            pm.sendRequest(loginRequest, (error, response) => {",
          "                if (error) {",
          "                    console.error('Login request failed:', error);",
          "                } else {",
          "                    try {",
          "                        const jsonResponse = response.json();",
          "                        ",
          "                        if (jsonResponse.status === 'success' && jsonResponse.token) {",
          "                            // Store the token in environment variable",
          "                            pm.environment.set('token', jsonResponse.token);",
          "                            console.log('Token fetched and stored successfully!');",
          "                        } else {",
          "                            console.error('Login failed or no token in response:', jsonResponse);",
          "                        }",
